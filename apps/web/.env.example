# URL de base de l'API (sans /api/v1, ajouté par lib/api/http.ts).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# "fixtures" (défaut) : toutes les routes J1 renvoient encore 501 côté backend, l'app
# fonctionne contre des données simulées en mémoire (lib/api/fixtures). "live" bascule
# tous les appels vers NEXT_PUBLIC_API_BASE_URL — à activer quand le backend aura
# implémenté la logique métier des lots 1 à 5.
NEXT_PUBLIC_API_MODE=fixtures
