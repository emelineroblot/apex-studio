# Copier en .env pour le développement local — ne jamais committer .env.
# Valeurs ci-dessous : exemples de développement, pas de secrets réels.

# --- Application ---
APP_ENV=local

# --- Base de données ---
# Dev  : postgresql+psycopg://apex:apex@localhost:55432/apex
# Test : postgresql+psycopg://apex:apex@localhost:55433/apex_test (lue par tests/conftest.py)
DATABASE_URL=postgresql+psycopg://apex:apex@localhost:55432/apex
# En ligne (Supabase) : DATABASE_URL = onglet « Transaction pooler » (port 6543),
# DATABASE_URL_DIRECT = onglet « Session pooler » (port 5432), reserve a Alembic.
# Ne jamais prendre l'onglet « Direct connection » : IPv6 uniquement.
# Laisser vide en local : les migrations reprennent alors DATABASE_URL.
DATABASE_URL_DIRECT=

# --- Auth ---
JWT_SECRET=dev-secret-change-me
JWT_TTL_MINUTES=480

# --- Stockage objet (Supabase Storage, endpoint S3-compatible, region UE) ---
# Storage → Settings → S3 connection : l'endpoint se termine par /storage/v1/s3, et la
# region est celle du projet (ex. eu-west-1) — jamais « auto », contrairement a R2.
S3_ENDPOINT_URL=https://<ref>.storage.supabase.co/storage/v1/s3
S3_REGION=eu-west-1
S3_BUCKET=apex-media
S3_ACCESS_KEY_ID=changeme
S3_SECRET_ACCESS_KEY=changeme

# --- Frontend / liens publics ---
WEB_ORIGIN=http://localhost:3000
PUBLIC_WEB_BASE_URL=http://localhost:3000

# --- Worker / cron (serverless) ---
WORKER_SECRET=dev-worker-secret
CRON_SECRET=dev-cron-secret

# --- Comptes de démo (seed) ---
DEMO_OWNER_PASSWORD=changeme-owner
DEMO_PHOTOGRAPHER_PASSWORD=changeme-photographer

# --- OCR (J2) ---
OCR_MODEL_DIR=./models

# --- Jeu de démo (J2) --- : dossier local de photos réelles libres de droits, absent par
# défaut (pas encore sourcées, cf. brief) — le générateur se limite alors au synthétique.
REAL_PHOTOS_DIR=./demo-photos

# --- Limites ---
MAX_UPLOAD_BYTES=26214400
DEFAULT_SHOOTING_QUOTA_BYTES=2147483648
